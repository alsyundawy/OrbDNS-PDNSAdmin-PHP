APP_NAME="PDNS Admin"
APP_ENV=production
APP_DEBUG=false
APP_KEY=CHANGE_ME_32_BYTES_RANDOM_STRING_HERE
APP_URL=https://pdns.yourdomain.com
APP_TIMEZONE=Asia/Jakarta
APP_FORCE_HTTPS=true
APP_ENABLE_GZIP=true
APP_CACHE_DRIVER=apcu
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pdns_admin
DB_USER=pdns_admin
DB_PASS=STRONG_PASSWORD_HERE
PDNS_API_URL=http://127.0.0.1:8081
PDNS_API_KEY=YOUR_PDNS_API_KEY
PDNS_SERVER=localhost
PDNS_TIMEOUT=10
PDNS_CACHE_TTL=60
SESSION_LIFETIME=7200
SESSION_SECURE=true
SESSION_SAMESITE=Strict
BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
TOTP_ENABLED=true
RATE_LIMIT_DRIVER=apcu
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW=60
